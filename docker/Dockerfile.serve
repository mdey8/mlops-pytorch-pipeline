FROM python:3.11-slim AS serving

WORKDIR /app

# Install non-root system dependencies and create a dedicated app user
RUN useradd -m appuser && \
    mkdir -p /app/models /app/checkpoints && \
    chown -R appuser:appuser /app

# Install inference dependencies only
COPY requirements/serve.txt .
RUN pip install --no-cache-dir -r serve.txt

# Copy application source files
COPY src/ ./src/
COPY configs/ ./configs/

# Change ownership to non-root user
RUN chown -R appuser:appuser /app

USER appuser

ENV PYTHONUNBUFFERED=1
EXPOSE 8080

# Health check instruction
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health')" || exit 1

ENTRYPOINT ["python", "-m", "src.serve"]